{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hollis-labs.dev/fragments-engine/browser-capture-reader/v1/reader-collection-create.schema.json",
  "title": "ReaderCollectionCreate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "kind": {
      "description": "Display hint. playlist, reading_list and research are well known; collection is the default.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    }
  }
}
